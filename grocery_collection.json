              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Grab the token saved during registration - required for all authenticated requests\r",
                  "const token = pm.collectionVariables.get(\"apiToken\");\r",
                  "console.log(\"Using token:\", token);\r",
                  "\r",
                  "// If token is missing, it means registration didn't run first or it failed\r",
                  "if (!token) {\r",
