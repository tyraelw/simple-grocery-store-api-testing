        {
          "name": "Get all products",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Response is a valid products array\", () => {\r",
                  "    const response = pm.response.json();\r",
                  "    pm.expect(response).to.be.an('array');\r",
                  "    pm.expect(response.length).to.be.greaterThan(0);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Products have correct structure\", () => {\r",
                  "    const response = pm.response.json();\r",
                  "    const firstProduct = response[0];\r",
                  "    \r",
                  "    pm.expect(firstProduct).to.have.property('id');\r",
                  "    pm.expect(firstProduct).to.have.property('category');\r",
                  "    pm.expect(firstProduct).to.have.property('name');\r",
                  "    pm.expect(firstProduct).to.have.property('inStock');\r",
                  "});\r",
                  "\r",
                  "// Save a random product ID to reuse in later requests (e.g. GET, UPDATE, DELETE)\r",
                  "const response = pm.response.json();\r",
                  "\r",
                  "if (response.length > 0) {\r",
                  "    // Math.random() gives a decimal between 0 and 1\r",
                  "    // Multiply by array length to get a number within range\r",
                  "    // Math.floor rounds it down to a valid whole index\r",
                  "    const randomProduct = response[Math.floor(Math.random() * response.length)];\r",
                  "    \r",
                  "    pm.collectionVariables.set('productId', randomProduct.id);\r",
                  "    console.log(\"Saved product ID:\", randomProduct.id, \"-\", randomProduct.name);\r",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
